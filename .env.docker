# ============================================
# 英语家教系统 - 环境变量模板（可入库）
# 服务器上使用:
#   cp .env.docker .env && vim .env   ← 填入真实值
#   docker compose up -d --build
# ============================================

# 宿主机 MySQL 连接（用 root 直连时，先执行 root@'%' 授权命令，见部署文档）
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码

# 阿里云 OSS（必填！否则图片上传会失败）
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=你的AccessKeyId
ALIYUN_OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
ALIYUN_OSS_BUCKET_NAME=java-ssq-mine
ALIYUN_OSS_REGION=cn-beijing

# AI 大模型（必填！否则 AI 助手/词汇扩展不可用）
AI_API_KEY=你的百炼APIKey

# 阿里云短信（可选：家长端作业逾期提醒。四项齐全才真实发送，
# 留空则自动降级为仅站内通知，不影响系统运行）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
